  "bugs": {
    "url": "https://github.com/Taiiwo/TaiiNet/issues"
  },
  "homepage": "https://github.com/Taiiwo/TaiiNet#readme",
  "dependencies": {
    "mingo": "^7.2.1",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/simple-peer": "^9.11.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }

{
  "name": "taiinet",
  "version": "1.0.0",
  "description": "Fully decentralized peer to peer mesh networking for the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
